PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
FERNET_KEY=
# app database; sqlite path is relative to backend/ (run app and alembic from there)
DATABASE_URL=sqlite:///./dev.db
# public URL for plaid webhooks, e.g. https://<id>.ngrok.app/plaid/webhook (optional)
PLAID_WEBHOOK_URL=
# local LLM via ollama (run `ollama serve`, then `ollama pull llama3.1:8b`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# sampling temperature; 0 keeps eval runs repeatable
LLM_TEMPERATURE=0
# where the privacy gateway logs every prompt it builds (default: backend/logs/prompt_audit.jsonl)
PROMPT_AUDIT_PATH=
# embedding model for the knowledge base (run `ollama pull nomic-embed-text`)
OLLAMA_EMBED_MODEL=nomic-embed-text
# knowledge base root holding sources/ and the chroma store (default: <repo>/kb)
KB_DIR=
# context window for the chat model, in tokens
LLM_NUM_CTX=8192
# where chat conversations are checkpointed (default: backend/data/checkpoints.db)
CHAT_CHECKPOINT_PATH=
# most tokens one chat model reply may generate
LLM_NUM_PREDICT=1024
# seconds to wait on ollama before a chat turn fails
LLM_TIMEOUT_SECONDS=300
# the agent's daily schedule (TPC-21): 1/true/yes to run each real user's budget check every morning
ENABLE_SCHEDULER=
# when the daily budget run and the month-end slot (on the 1st) fire, in SCHEDULER_TZ
DAILY_RUN_TIME=06:00
CLOSE_RUN_TIME=05:00
SCHEDULER_TZ=America/New_York
# development only: 1/true/yes exposes /admin routes that advance simulated users (never for real use)
ENABLE_ADMIN=
# where budget runs waiting on the user's approval are checkpointed (default: backend/data/budget_checkpoints.db)
BUDGET_CHECKPOINT_PATH=
